# Infrastructure
POSTGRES_DB=foreign_trade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/foreign_trade
REDIS_URL=redis://redis:6379/0

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=foreign-trade
NEXT_PUBLIC_API_URL=http://localhost:8000

# Generate distinct production values before deployment.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_SECRET=replace-with-a-long-random-secret
