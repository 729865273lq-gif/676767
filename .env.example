# Infrastructure
POSTGRES_DB=foreign_trade
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/foreign_trade
REDIS_URL=redis://redis:6379/0

# Object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=foreign-trade
NEXT_PUBLIC_API_URL=http://localhost:8000

# Embedding / knowledge base retrieval (OpenAI-compatible /embeddings endpoint)
EMBEDDING_API_BASE=replace-with-your-embedding-api-base
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=BAAI/bge-m3

# Generate distinct production values before deployment.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_SECRET=replace-with-a-long-random-secret

# Search
BOCHA_API_KEY=replace-with-your-bocha-api-key
GOOGLE_CSE_API_KEY=replace-with-your-google-cse-api-key
GOOGLE_CSE_CX=replace-with-your-google-cse-id
GOOGLE_PLACES_API_KEY=replace-with-your-google-places-api-key
TOMTOM_API_KEY=replace-with-your-tomtom-api-key
GEOAPIFY_API_KEY=replace-with-your-geoapify-api-key
FOURSQUARE_API_KEY=replace-with-your-foursquare-service-key
SERPAPI_API_KEY=replace-with-your-serpapi-api-key
DATAFORSEO_LOGIN=replace-with-your-dataforseo-login
DATAFORSEO_PASSWORD=replace-with-your-dataforseo-password

# Customer development APIs
TRADESPARQ_API_ID=replace-with-your-tradesparq-api-id
TRADESPARQ_API_SECRET=replace-with-your-tradesparq-api-secret
APOLLO_API_KEY=replace-with-your-apollo-api-key
HUNTER_API_KEY=replace-with-your-hunter-api-key
ZEROBOUNCE_API_KEY=replace-with-your-zerobounce-api-key
NEVERBOUNCE_API_KEY=replace-with-your-neverbounce-api-key

# Outbound email. For Gmail or Outlook, use an app password or SMTP credential
# only for local development; production should move to OAuth.
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=replace-with-sender-email
SMTP_FROM_NAME=Trade Axis
SMTP_USE_TLS=true

# Inbound email (IMAP). QQ Mail defaults: imap.qq.com / 993, INBOX.
# IMAP_USERNAME is usually the same mailbox address as SMTP_USERNAME.
IMAP_HOST=replace-with-imap-host
IMAP_PORT=993
IMAP_USERNAME=replace-with-imap-username
IMAP_PASSWORD=replace-with-imap-password
IMAP_SENT_MAILBOX=
INBOX_POLL_SECONDS=120

# Optional LLM for reply classification refinement (OpenAI-compatible /chat/completions).
LLM_API_BASE=replace-with-your-llm-api-base
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=gpt-4o-mini
